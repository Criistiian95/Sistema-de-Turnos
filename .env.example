NODE_ENV=development
PORT=3003
FRONTEND_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Railway: DATABASE_URL=${{MySQL.MYSQL_URL}} (set in Railway, not literally here)
# DATABASE_URL=mysql://user:password@host:3306/sismed
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sismed
DB_USER=sismed
DB_PASSWORD=
# Only used by local Docker Compose:
MYSQL_ROOT_PASSWORD=
# Optional shared invitation code: empty disables public registration.
REGISTRATION_CODE=
# Temporary, only for npm run admin:create:
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_LASTNAME=
